{% block paragraph %}
  {% embed "@hdbt/misc/component.twig" with
    {
      component_classes: [ 'component--article-series' ],
      component_title: content.field_title,
      component_description: content.field_description,
      component_content_class: 'article-series',
    }
  %}
    {% block component_content %}
      {{ drupal_view('article', 'article_series', paragraph.field_article_series.target_id) }}
    {% endblock component_content %}
  {% endembed %}
{% endblock paragraph %}
